# Copy to .env.production.local and fill in from:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (optional, recommended): Fraud Defense (reCAPTCHA Enterprise) site key — see README "App Check".
VITE_RECAPTCHA_SITE_KEY=
# Only for running the dev server against the real project with App Check enforced.
VITE_APPCHECK_DEBUG_TOKEN=
